# Base44 sandbox defaults for AutoData.
#
# Loaded FIRST by docker-compose.base44.yml so the stack boots without external
# credentials. The platform-managed secret file (/run/base44/app.env) is listed
# after this file and therefore overrides any key defined here.
#
# These are non-secret local values. Keep them free of user-supplied API keys.

# External source connectors (bankone/banktwo) authenticate with
# AUTODATA_BANKONE_API_KEY / AUTODATA_BANKTWO_API_KEY, which are supplied
# through the Base44 secrets dashboard, not from this file.
BANKONE_BASE_URL=https://bankone.cars.tk
BANKTWO_BASE_URL=https://banktwo.cars.tk

# Optional external AI provider (Mercury2 job plans / procedure composition).
INCEPTION_API_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-2
