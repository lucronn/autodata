# Base44 sandbox development defaults for internal, non-credential settings.
#
# This file is listed FIRST in every service's env_file so that real values
# uploaded to the Base44 dashboard (delivered through /run/base44/app.env, which
# is listed LAST) always win. Never put a user-supplied external credential
# here.
#
# Shared secret between the Go API and the internal Python ingestion HTTP
# service. Local development only.
AUTODATA_INGESTION_INTERNAL_TOKEN=local-dev-ingestion-token

# HMAC key for catalog media URLs served by the API (AUTODATA_IMAGE_URL_KEY).
# Without a stable key the API intentionally omits image URLs.
AUTODATA_IMAGE_URL_KEY=local-dev-catalog-image-key

# Signing secret for the deterministic local payment fixture used by the
# ingest-fixture seed (the repository's own Compose uses the same local value).
AUTODATA_FAKE_PAYMENT_SIGNING_SECRET=local-fixture-signing-key
