{
  "schema_version": 1,
  "data_state": [
    "normalized",
    "source_unnormalized",
    "normalizing",
    "mixed",
    "unavailable",
    "needs_review"
  ],
  "answer_status": [
    "options",
    "processing",
    "available",
    "partial",
    "complete",
    "failed",
    "needs_review"
  ],
  "dataset_availability": [
    "purchased",
    "fast_lane_processing",
    "viewable",
    "enriching",
    "complete",
    "failed",
    "needs_review",
    "revoked"
  ],
  "section_status": [
    "pending",
    "processing",
    "viewable",
    "complete",
    "failed",
    "needs_review"
  ],
  "event_subjects": [
    "dataset.fast.requested",
    "dataset.viewable",
    "dataset.deep.requested",
    "dataset.knowledge.fallback.requested",
    "dataset.section.published",
    "dataset.enrichment.failed",
    "dataset.review.requested",
    "dataset.revision.revoked",
    "chat.answer.updated",
    "chat.vehicle.options",
    "chat.worker.progress",
    "chat.price.refresh.requested",
    "chat.procedure.published",
    "chat.visual.published"
  ],
  "procedure_step": {
    "required": ["step_number", "instruction", "source_article_ids", "evidence_ids"],
    "properties": {
      "step_number": {"type": "integer"},
      "instruction": {"type": "string"},
      "operation_id": {"type": "string", "optional": true},
      "source_article_ids": {"type": "array"},
      "evidence_ids": {"type": "array"},
      "safety_warnings": {"type": "array", "optional": true},
      "visual_artifact_ids": {"type": "array", "optional": true}
    }
  },
  "visual_artifact": {
    "required": ["artifact_id", "source_artifact_key", "derived_artifact_key", "review_state"],
    "properties": {
      "artifact_id": {"type": "uuid"},
      "source_artifact_key": {"type": "string"},
      "derived_artifact_key": {"type": "string"},
      "source_uri": {"type": "string", "optional": true},
      "processor": {"type": "string", "optional": true},
      "processor_version": {"type": "string", "optional": true},
      "review_state": {"enum": ["pending", "approved", "rejected"]},
      "label": {"type": "string", "optional": true}
    }
  },
  "price_snapshot": {
    "required": [
      "canonical_part_id",
      "source_part_number",
      "amount",
      "currency",
      "priced_at",
      "freshness",
      "source_snapshot_id",
      "refresh_status",
      "markup_applied"
    ],
    "properties": {
      "canonical_part_id": {"type": "string"},
      "source_part_number": {"type": "string"},
      "amount": {"type": "number"},
      "currency": {"type": "string"},
      "priced_at": {"type": "string"},
      "freshness": {"enum": ["fresh", "stale", "unknown"]},
      "source_snapshot_id": {"type": "uuid"},
      "refresh_status": {"enum": ["current", "queued", "processing", "failed"]},
      "markup_applied": {"type": "boolean", "const": false},
      "source_uri": {"type": "string", "optional": true}
    }
  },
  "chat_quote": {
    "required": [
      "required_hours",
      "recommended_hours",
      "total_hours",
      "overlap_hours_removed",
      "overlap_operations",
      "parts",
      "evidence"
    ],
    "properties": {
      "required_hours": {"type": "number"},
      "recommended_hours": {"type": "number"},
      "total_hours": {"type": "number"},
      "overlap_hours_removed": {"type": "number"},
      "overlap_operations": {"type": "array"},
      "parts": {"type": "array"},
      "evidence": {"type": "array"},
      "currency": {"type": "string", "optional": true}
    }
  },
  "chat_answer": {
    "required": [
      "answer_status",
      "data_state",
      "vehicle",
      "procedure",
      "quote",
      "warnings",
      "updated_at",
      "worker_stream"
    ],
    "properties": {
      "answer_status": {"enum_ref": "answer_status"},
      "data_state": {"enum_ref": "data_state"},
      "vehicle": {"type": "object"},
      "procedure": {"type": "object", "nullable": true},
      "quote": {"type": "object", "nullable": true},
      "warnings": {"type": "array"},
      "updated_at": {"type": "string"},
      "worker_stream": {"type": "array"},
      "source_watermark": {"type": "string", "optional": true},
      "revision_id": {"type": "uuid", "nullable": true, "optional": true}
    }
  },
  "chat_query": {
    "required": [
      "query_id",
      "conversation_id",
      "message",
      "idempotency_key",
      "status",
      "vehicle_options",
      "answer",
      "correlation_id"
    ],
    "properties": {
      "query_id": {"type": "uuid"},
      "conversation_id": {"type": "uuid"},
      "message": {"type": "string"},
      "idempotency_key": {"type": "string"},
      "status": {"enum": ["awaiting_vehicle", "processing", "available", "failed", "revoked"]},
      "vehicle_options": {"type": "array"},
      "answer": {"type": "object", "nullable": true},
      "correlation_id": {"type": "uuid"}
    }
  },
  "chat_selection": {
    "required": ["query_id", "selection_type", "option_number"],
    "properties": {
      "query_id": {"type": "uuid"},
      "selection_type": {"enum": ["vehicle", "retry"]},
      "option_number": {"type": "integer", "nullable": true},
      "vehicle_id": {"type": "uuid", "nullable": true}
    }
  },
  "worker_progress_event": {
    "required": [
      "event_id",
      "event_type",
      "event_version",
      "occurred_at",
      "producer",
      "request_id",
      "projection_id",
      "revision_id",
      "correlation_id",
      "idempotency_key",
      "payload",
      "query_id",
      "stage",
      "status",
      "data_state",
      "message"
    ],
    "properties": {
      "event_id": {"type": "uuid"},
      "event_type": {"type": "string"},
      "event_version": {"type": "integer"},
      "occurred_at": {"type": "string"},
      "producer": {"type": "string"},
      "request_id": {"type": "uuid"},
      "projection_id": {"type": "uuid"},
      "revision_id": {"type": "uuid", "nullable": true},
      "correlation_id": {"type": "uuid"},
      "idempotency_key": {"type": "string"},
      "payload": {"type": "object"},
      "query_id": {"type": "uuid"},
      "stage": {"type": "string"},
      "status": {"enum": ["queued", "processing", "completed", "failed", "dead_letter"]},
      "data_state": {"enum_ref": "data_state"},
      "message": {"type": "string"}
    }
  },
  "dataset_read": {
    "required": [
      "dataset_id",
      "revision_id",
      "availability",
      "source_watermark",
      "sections"
    ],
    "properties": {
      "dataset_id": {"type": "uuid"},
      "revision_id": {"type": "uuid"},
      "availability": {"enum_ref": "dataset_availability"},
      "source_watermark": {"type": "string"},
      "sections": {"type": "array", "items": "dataset_section"},
      "data": {"type": "object", "optional": true},
      "warnings": {"type": "array", "optional": true}
    }
  },
  "knowledge_result_kind": ["article", "procedure"],
  "knowledge_search_response": {
    "required": ["dataset_id", "revision_id", "availability", "source_watermark", "sections", "results"],
    "properties": {
      "dataset_id": {"type": "uuid"},
      "revision_id": {"type": "uuid"},
      "availability": {"enum_ref": "dataset_availability"},
      "source_watermark": {"type": "string"},
      "sections": {"type": "array", "items": "dataset_section"},
      "vehicle_identity": {"type": "object", "optional": true},
      "fallback_status": {"enum": ["pending", "fetched"], "optional": true},
      "fallback_request_id": {"type": "uuid", "optional": true},
      "results": {"type": "array", "items": "knowledge_result"}
    }
  },
  "knowledge_result": {
    "required": ["kind", "id", "score", "evidence"],
    "properties": {
      "kind": {"enum_ref": "knowledge_result_kind"},
      "id": {"type": "string"},
      "score": {"type": "number"},
      "article": {"type": "object", "optional": true},
      "procedure": {"type": "object", "optional": true},
      "evidence": {"type": "array", "items": "knowledge_evidence"}
    }
  },
  "knowledge_article": {
    "required": ["article_id"],
    "properties": {
      "article_id": {"type": "string"},
      "article_key": {"type": "string", "optional": true},
      "bucket": {"type": "string", "optional": true},
      "title": {"type": "string", "optional": true},
      "bulletin_number": {"type": "string", "optional": true},
      "release_date": {"type": "string", "optional": true},
      "body": {"type": "string", "optional": true},
      "steps": {"type": "array", "optional": true}
    }
  },
  "knowledge_procedure": {
    "required": ["procedure_id", "section", "excerpt"],
    "properties": {
      "procedure_id": {"type": "string"},
      "section": {"type": "string"},
      "excerpt": {"type": "string"},
      "matched_terms": {"type": "array", "optional": true}
    }
  },
  "knowledge_evidence": {
    "required": ["evidence_id", "locator", "confidence"],
    "properties": {
      "evidence_id": {"type": "string"},
      "locator": {"type": "string"},
      "source_snapshot_id": {"type": "string", "optional": true},
      "artifact_key": {"type": "string", "optional": true},
      "source_uri": {"type": "string", "optional": true},
      "source_version": {"type": "string", "optional": true},
      "extracted_text": {"type": "string", "optional": true},
      "confidence": {"type": "number"},
      "reviewer_state": {"enum": ["pending", "approved", "rejected"], "optional": true}
    }
  },
  "dataset_section": {
    "required": ["name", "status", "last_published_revision", "updated_at"],
    "properties": {
      "name": {"type": "string"},
      "status": {"enum_ref": "section_status"},
      "last_published_revision": {"type": "uuid", "nullable": true},
      "updated_at": {"type": "string"}
    }
  },
  "dataset_request": {
    "required": ["request_id", "product_id", "vehicle_key", "status"],
    "properties": {
      "request_id": {"type": "uuid"},
      "product_id": {"type": "uuid"},
      "vehicle_key": {"type": "string"},
      "status": {"enum_ref": "dataset_availability"}
    }
  },
  "entitlement": {
    "required": ["entitlement_id", "organization_id", "dataset_request_id", "status"],
    "properties": {
      "entitlement_id": {"type": "uuid"},
      "organization_id": {"type": "uuid"},
      "dataset_request_id": {"type": "uuid"},
      "status": {"enum": ["active", "revoked"]}
    }
  },
  "evidence": {
    "required": ["evidence_id", "source_snapshot_id", "extraction_run_id", "locator", "confidence"],
    "properties": {
      "evidence_id": {"type": "uuid"},
      "source_snapshot_id": {"type": "uuid"},
      "extraction_run_id": {"type": "uuid", "nullable": true},
      "locator": {"type": "string"},
      "confidence": {"type": "number"}
    }
  },
  "feedback": {
    "required": ["feedback_id", "dataset_id", "category", "body"],
    "properties": {
      "feedback_id": {"type": "uuid"},
      "dataset_id": {"type": "uuid"},
      "category": {"enum": ["correction", "missing", "quality", "safety"]},
      "body": {"type": "string"}
    }
  },
  "error": {
    "required": ["code", "message", "request_id", "retryable", "details"],
    "properties": {
      "code": {"enum": [
        "UNAUTHENTICATED",
        "ENTITLEMENT_REQUIRED",
        "FORBIDDEN",
        "ENTITLEMENT_REVOKED",
        "DATASET_NOT_VIEWABLE",
        "SECTION_FAILED",
        "REVISION_NOT_FOUND",
        "DUPLICATE_REQUEST",
        "INVALID_EVIDENCE",
        "REVIEW_REQUIRED",
        "SOURCE_REVIEW_NOT_FOUND",
        "SOURCE_REVIEW_CONFLICT",
        "INGESTION_UNAVAILABLE",
        "INVALID_REQUEST"
      ]},
      "message": {"type": "string"},
      "request_id": {"type": "uuid"},
      "retryable": {"type": "boolean"},
      "details": {"type": "object"}
    }
  },
  "event_envelope": {
    "required": [
      "event_id",
      "event_type",
      "event_version",
      "occurred_at",
      "producer",
      "request_id",
      "projection_id",
      "revision_id",
      "correlation_id",
      "idempotency_key",
      "payload"
    ],
    "properties": {
      "event_id": {"type": "uuid"},
      "event_type": {"type": "string"},
      "event_version": {"type": "integer"},
      "occurred_at": {"type": "string"},
      "producer": {"type": "string"},
      "request_id": {"type": "uuid"},
      "projection_id": {"type": "uuid"},
      "revision_id": {"type": "uuid", "nullable": true},
      "correlation_id": {"type": "uuid"},
      "idempotency_key": {"type": "string"},
      "payload": {"type": "object"}
    }
  }
}
