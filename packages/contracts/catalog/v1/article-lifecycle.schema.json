{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodata.example/contracts/catalog/v1/article-lifecycle.schema.json",
  "$defs": {
    "article_processing_state": {
      "type": "string",
      "enum": [
        "queued",
        "fetching_source",
        "normalizing",
        "rewriting",
        "validating",
        "publishing",
        "completed",
        "failed",
        "needs_review"
      ]
    },
    "article_content_origin": {
      "type": "string",
      "enum": [
        "source",
        "canonical"
      ]
    },
    "article_review_status": {
      "type": "string",
      "enum": [
        "UNREVIEWED",
        "APPROVED",
        "REJECTED"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "normalization_version",
        "blocks"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "normalization_version": {
          "const": "ordered-article-v1"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "block_id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "unavailable_reason": {
                "type": "string"
              },
              "asset_id": {
                "type": "string"
              },
              "image_id": {
                "type": "string"
              },
              "source_locator": {
                "type": "string"
              },
              "source_order": {
                "type": "integer"
              },
              "level": {
                "type": "integer"
              },
              "number": {
                "type": "integer"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "asset_id": {
                            "type": "string"
                          },
                          "image_id": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "unavailable_reason": {
                            "type": "string"
                          },
                          "evidence_ids": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "images": {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/image"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "caption": {
                "type": "string"
              },
              "images": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/image"
                }
              }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "image_id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^/v1/catalog/images/[^?]+$"
        },
        "alt": {
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "image/svg+xml"
          ]
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "localized"
          ]
        },
        "unavailable_reason": {
          "type": "string"
        },
        "asset_id": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "vehicle_id",
        "title",
        "content_status",
        "complete"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "vehicle_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "canonical_article_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_revision_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "canonical_revision_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "view_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "content_status": {
          "enum": [
            "list_only",
            "content_partial",
            "content_complete"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "content_origin": {
          "enum": [
            null,
            "source",
            "canonical"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "pending",
            "unavailable"
          ]
        },
        "review_status": {
          "enum": [
            null,
            "UNREVIEWED",
            "APPROVED",
            "REJECTED"
          ]
        },
        "processing": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "job_id",
            "state",
            "retryable",
            "retry_after_seconds",
            "error_code",
            "updated_at"
          ],
          "properties": {
            "job_id": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "$ref": "#/$defs/article_processing_state"
            },
            "retryable": {
              "type": "boolean"
            },
            "retry_after_seconds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "error_code": {
              "enum": [
                null,
                "CATALOG_SOURCE_UNAVAILABLE",
                "CATALOG_REWRITE_UNAVAILABLE",
                "CATALOG_REWRITE_REJECTED",
                "CATALOG_REVIEW_REQUIRED"
              ]
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "document": {
          "oneOf": [
            {
              "$ref": "#/$defs/document"
            },
            {
              "type": "null"
            }
          ]
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "image_id": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^/v1/catalog/images/[^?]+$"
              },
              "alt": {
                "type": "string"
              },
              "media_type": {
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/gif",
                  "image/webp",
                  "image/svg+xml"
                ]
              },
              "status": {
                "enum": [
                  "available",
                  "unavailable",
                  "localized"
                ]
              },
              "unavailable_reason": {
                "type": "string"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instructions"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "description": "Explicit source step number, when present. Canonical document traversal does not fabricate numbers."
              },
              "heading": {
                "type": "string"
              },
              "instructions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "image_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "text": {
                "type": "string"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "action": {
                "type": "string"
              },
              "images": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/image"
                }
              }
            }
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "source_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "snapshot_id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "content_sha256": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^/v1/catalog/vehicles/[^?]+/articles/[^?]+/source(?:\\?source_revision_id=[^&]+)?$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            },
            "required": [
              "complete"
            ]
          },
          "then": {
            "required": [
              "canonical_article_id",
              "source_revision_id",
              "canonical_revision_id",
              "content_origin",
              "document",
              "processing"
            ],
            "properties": {
              "canonical_article_id": {
                "type": "string"
              },
              "source_revision_id": {
                "type": "string"
              },
              "canonical_revision_id": {
                "type": "string"
              },
              "content_origin": {
                "const": "canonical"
              },
              "content_status": {
                "const": "content_complete"
              },
              "document": {
                "$ref": "#/$defs/document"
              },
              "processing": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "completed"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_origin": {
                "const": "source"
              }
            },
            "required": [
              "content_origin"
            ]
          },
          "then": {
            "properties": {
              "complete": {
                "const": false
              },
              "canonical_revision_id": {
                "type": "null"
              },
              "content_status": {
                "const": "content_partial"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "pending"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "required": [
              "processing"
            ],
            "properties": {
              "complete": {
                "const": false
              },
              "content_origin": {
                "type": "null"
              },
              "canonical_revision_id": {
                "type": "null"
              },
              "document": {
                "type": "null"
              },
              "processing": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "article"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "article": {
      "$ref": "#/$defs/article"
    }
  }
}
