{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner authorization for isolated staging bare resources",
  "description": "Fixed /etc/autodata/staging-bootstrap.json; parser additionally binds host config, staging, resource scope and expiry (future, at most 24 hours). Evidence hashes bind owner review; they do not prove effective IAM or network enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "authorization_id",
    "expires_at",
    "service_config_sha256",
    "resource_nonce",
    "boot_image",
    "network",
    "attached_identity",
    "bootstrap_identity_evidence_sha256",
    "owner_cost_and_region_evidence_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "operation": {
      "const": "create-staging-resources"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "service_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "boot_image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_link",
        "id",
        "architecture"
      ],
      "properties": {
        "self_link": {
          "type": "string",
          "pattern": "^https://www\\.googleapis\\.com/compute/v1/projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/global/images/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "architecture": {
          "const": "X86_64"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_self_link",
        "subnetwork_self_link",
        "reviewed_firewall_evidence_sha256",
        "reviewed_routes_evidence_sha256"
      ],
      "properties": {
        "network_self_link": {
          "type": "string",
          "pattern": "^https://www\\.googleapis\\.com/compute/v1/projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/global/networks/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "subnetwork_self_link": {
          "type": "string",
          "pattern": "^https://www\\.googleapis\\.com/compute/v1/projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/regions/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?/subnetworks/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "reviewed_firewall_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed_routes_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "attached_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email",
        "reviewed_iam_evidence_sha256"
      ],
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^autodata-api-firebase@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"
        },
        "reviewed_iam_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "bootstrap_identity_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "owner_cost_and_region_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
