# Private rendered file: /run/autodata/nats/nats.conf, never release Config.Env.
# @@ tokens are replaced by the private delivery renderer, never a shell/eval.
server_name: autodata-production
listen: 0.0.0.0:4222
http: 127.0.0.1:8222
jetstream { store_dir: /data/jetstream }
max_payload: 1048576
write_deadline: "5s"
authorization {
  users: [
    { user: "@@NATS_METRICS_USER@@", password: "@@NATS_METRICS_PASSWORD@@",
      permissions: {
        publish: { allow: ["$JS.API.INFO"] },
        subscribe: { allow: ["_INBOX.>"] }
      }
    },
    { user: "@@NATS_OUTBOX_USER@@", password: "@@NATS_OUTBOX_PASSWORD@@",
      permissions: {
        publish: { allow: ["catalog.article.published", "dataset.fast.requested", "dataset.viewable", "dataset.deep.requested",
          "dataset.section.published", "dataset.enrichment.failed", "dataset.review.requested", "dataset.revision.revoked",
          "dataset.knowledge.fallback.requested", "$JS.API.STREAM.INFO.AUTODATA", "$JS.API.STREAM.INFO.AUTODATA_CATALOG",
          "$JS.API.STREAM.CREATE.AUTODATA", "$JS.API.STREAM.CREATE.AUTODATA_CATALOG"] },
        subscribe: { allow: ["_INBOX.>"] }
      }
    }
  ]
}
