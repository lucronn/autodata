# NONSECRET NAME INVENTORY ONLY. Empty values are intentionally not deployable.
# Do not source this file or pass it as Compose env_file. The host-v2 renderer accepts
# explicit validated host.json/release.json objects; it never reads ambient env.
# Schema: runtime-check.py validate_config + release.schema.json. Populate through
# reviewed bootstrap/config delivery, then bind canonical config SHA in release.
# host.json.schema_version must be 2 and workshop_purchase_config is required.
# Exactly seven structured keys; an explicit disabled object is:
# {"enabled":false,"terms_version":"workshop-v1","terms_url":null,
#  "privacy_url":null,"refund_url":null,"contact_url":null,"tax_notice":null}
# Enabled URLs/notices require separate owner review. Hash the original object.
# AUTODATA_WORKSHOP_PURCHASE_CONFIG_JSON is derived ONLY for ingestion-http;
# never supply it through this inventory or ambient environment. Canonical UTF-8
# JSON encodes each dollar as \u0024; the escaped wire must be <=16384 bytes.
# api and ingestion-http must reference the same numeric internal-token version.
HOST_PROJECT_ID=
FIREBASE_PROJECT_ID=
BACKUP_PROJECT_ID=
REGION=
ZONE=
INSTANCE_NAME=
DATA_DISK_NAME=
DATA_DISK_FILESYSTEM_UUID=
STATIC_IP_NAME=
ARTIFACT_REPOSITORY=
BACKUP_BUCKET=
DEPLOY_ENVIRONMENT=
PUBLIC_ORIGIN=
RELEASE_SHA=
ACME_EMAIL=
AUTODATA_FIREBASE_WEB_API_KEY=
AUTODATA_FIREBASE_WEB_APP_ID=
AUTODATA_FIREBASE_AUTH_DOMAIN=
AUTODATA_STRIPE_ACCOUNT_ID=
AUTODATA_STRIPE_PRICE_ID=
BANKONE_BASE_URL=
BANKTWO_BASE_URL=
INCEPTION_API_BASE_URL=
INCEPTION_MODEL=
INCEPTION_API_TIMEOUT_SECONDS=
AUTODATA_SOURCE_HTTP_TIMEOUT_SECONDS=
AUTODATA_SOURCE_MAX_BYTES=
AUTODATA_MERCURY2_EXTRACTION_ENABLED=
AUTODATA_MERCURY2_JOB_PLANS_ENABLED=
AUTODATA_MERCURY2_PROCEDURE_COMPOSITION_ENABLED=
# Pinned numeric secret-version resource references live only in
# release.json.secret_versions; credential values never belong in this file.
# Image digests/platform-specific IDs, provenance/SBOM, migration inventory,
# package pins, config hash and rollback identity live in release.json.
# No floating images or sample production pins are supplied by this milestone.
