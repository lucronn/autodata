{
  "policy_version": 1,
  "autonomy": {
    "allow_plan": true,
    "allow_implementation": true,
    "allow_pull_request_creation": true,
    "allow_pull_request_merge": true,
    "allow_github_project_updates": true,
    "allowed_deployment_targets": ["ephemeral", "dev"],
    "production_deployment": false
  },
  "merge_gate": {
    "required_decisions": [
      "deterministic_ci",
      "contract_compatibility",
      "schema_integrity",
      "source_provenance",
      "data_quality",
      "security",
      "reliability",
      "independent_review"
    ],
    "max_critical_findings": 0,
    "max_high_findings": 0,
    "min_evidence_completeness": 1.0,
    "min_fast_lane_provenance_coverage": 1.0
  },
  "data_quality": {
    "required_fast_lane_fields": [
      "vehicle.identity",
      "vehicle.source_metadata",
      "vehicle.core_specifications"
    ],
    "published_fact_requires_provenance": true,
    "published_extraction_requires_evidence": true,
    "published_revision_is_immutable": true,
    "allow_partial_deep_sections": true,
    "allow_unresolved_critical_safety_findings": false,
    "allow_unverified_unit_conversion": false
  },
  "retry": {
    "max_agent_retries": 2,
    "max_job_retries": 3,
    "require_alternate_reviewer_on_disagreement": true,
    "dead_letter_on_exhaustion": true
  },
  "protected_paths": [
    ".github/workflows/",
    ".autodata-autonomy-policy.json",
    "db/migrations/",
    "docs/agents/data-integrity-gates.md"
  ]
}
