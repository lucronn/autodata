{
  "openapi": "3.0.3",
  "info": {
    "title": "AutoData Provider-Neutral Catalog API",
    "version": "1.0.0",
    "description": "Catalog API for external applications. AutoData resolves the vehicle cascade and articles from its normalized database, hydrates missing scopes from configured sources, and returns source-backed vehicle-scoped procedure compositions. Article responses contain ordered normalized documents; immutable source originals remain internal.",
    "contact": {
      "name": "AutoData"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin AutoData API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Catalog",
      "description": "Vehicle selection and normalized article reads"
    }
  ],
  "paths": {
    "/v1/catalog/years": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listCatalogYears",
        "summary": "List available model years",
        "description": "Returns the normalized year manifest. A missing manifest triggers source hydration.",
        "responses": {
          "200": {
            "description": "Available years",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YearsResponse"
                },
                "example": {
                  "version": "v1",
                  "items": [
                    {
                      "year": 2024
                    },
                    {
                      "year": 2025
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/years/{year}/makes": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listCatalogMakes",
        "summary": "List makes for a model year",
        "parameters": [
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Region"
          }
        ],
        "responses": {
          "200": {
            "description": "Available makes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MakesResponse"
                },
                "example": {
                  "version": "v1",
                  "items": [
                    {
                      "id": "toyota",
                      "name": "Toyota"
                    },
                    {
                      "id": "honda",
                      "name": "Honda"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/years/{year}/makes/{make}/models": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listCatalogModels",
        "summary": "List models for a year and make",
        "parameters": [
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Make"
          },
          {
            "$ref": "#/components/parameters/Region"
          }
        ],
        "responses": {
          "200": {
            "description": "Available models",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                },
                "example": {
                  "version": "v1",
                  "items": [
                    {
                      "id": "rav4",
                      "name": "Rav4"
                    },
                    {
                      "id": "camry",
                      "name": "Camry"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/years/{year}/makes/{make}/models/{model}/configurations": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listCatalogConfigurations",
        "summary": "List engine, base, and trim configurations",
        "parameters": [
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Make"
          },
          {
            "$ref": "#/components/parameters/Model"
          },
          {
            "$ref": "#/components/parameters/Region"
          }
        ],
        "responses": {
          "200": {
            "description": "Available vehicle configurations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigurationsResponse"
                },
                "example": {
                  "version": "v1",
                  "items": [
                    {
                      "id": "065e138d-72ea-5110-b05e-d89f5445a251",
                      "vehicle_id": "0148245f-ec44-5172-bafe-0ad19e616098",
                      "year": 1997,
                      "make": "Toyota",
                      "model": "Rav4",
                      "region": "US",
                      "trim": "Base",
                      "engine": 2.0,
                      "complete": true
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/vehicles/{vehicle_id}/compositions": {
      "post": {
        "tags": ["Catalog"],
        "operationId": "composeVehicleProcedures",
        "summary": "Compose a vehicle-scoped multi-component procedure",
        "description": "Composes selected normalized source articles for the catalog vehicle. Missing individual articles may be ingested and persisted, but the combined result is response-only and is never stored as an article. Vehicle identity is resolved from the path; the body cannot override it.",
        "parameters": [
          { "$ref": "#/components/parameters/VehicleId" },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["query"],
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Natural-language repair request identifying the components to compose"
                  }
                }
              },
              "example": { "query": "Replace the oil pump and water pump" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Source-backed composition or an explicit needs-review result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["worker", "lane", "status", "requested_components", "selected_articles", "review_reasons", "procedure", "images", "source"],
                  "properties": {
                    "worker": { "type": "string", "example": "ingestion" },
                    "lane": { "type": "string", "example": "fast" },
                    "status": { "type": "string", "enum": ["ready", "needs_review"] },
                    "requested_components": { "type": "array", "items": { "type": "string" } },
                    "selected_articles": { "type": "array", "items": { "type": "string" } },
                    "review_reasons": { "type": "array", "items": { "type": "string" } },
                    "procedure": { "type": "object", "additionalProperties": true },
                    "images": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
                    "source": { "type": "object", "additionalProperties": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/InvalidRequest" },
          "500": { "$ref": "#/components/responses/CatalogUnavailable" },
          "502": {
            "description": "Ingestion worker is unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/APIError" }
              }
            }
          }
        }
      }
    },
    "/v1/catalog/vehicles/{vehicle_id}/articles": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listVehicleArticles",
        "summary": "List the vehicle's available articles",
        "description": "Returns the article catalog. Article bodies are hydrated only when the selected article detail is requested.",
        "parameters": [
          {
            "$ref": "#/components/parameters/VehicleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle article catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticlesResponse"
                },
                "example": {
                  "version": "v1",
                  "items": [
                    {
                      "id": "50064179-6be5-5fa7-8678-335cb42c523c",
                      "vehicle_id": "0148245f-ec44-5172-bafe-0ad19e616098",
                      "title": "Oil Pump Removal and Installation",
                      "kind": "procedure",
                      "component": "oil_pump",
                      "content_status": "content_complete",
                      "complete": true
                    },
                    {
                      "id": "0762fef0-536b-5cae-bd2a-bf9972082048",
                      "vehicle_id": "0148245f-ec44-5172-bafe-0ad19e616098",
                      "title": "Timing Belt Removal and Installation",
                      "kind": "procedure",
                      "component": "timing_belt",
                      "content_status": "content_complete",
                      "complete": true
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/vehicles/{vehicle_id}/articles/{article_id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "getNormalizedArticle",
        "summary": "Get one normalized article",
        "description": "Returns normalized content with fixed source order, local image references, and source provenance identifiers. Selecting a list-only article triggers one targeted source ingestion before the response.",
        "parameters": [
          {
            "$ref": "#/components/parameters/VehicleId"
          },
          {
            "$ref": "#/components/parameters/ArticleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Normalized article",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleResponse"
                },
                "example": {
                  "version": "v1",
                  "article": {
                    "id": "50064179-6be5-5fa7-8678-335cb42c523c",
                    "vehicle_id": "0148245f-ec44-5172-bafe-0ad19e616098",
                    "title": "Oil Pump Removal and Installation",
                    "kind": "procedure",
                    "component": "oil_pump",
                    "content_status": "content_complete",
                    "complete": true,
                    "body": "Remove the oil pan before removing the oil pump.",
                    "steps": [
                      {
                        "number": 1,
                        "heading": "Removal",
                        "instructions": [
                          "Disconnect the battery negative cable."
                        ],
                        "image_ids": []
                      },
                      {
                        "number": 2,
                        "heading": "Removal",
                        "instructions": [
                          "Remove the oil pan and detach the oil pump."
                        ]
                      }
                    ],
                    "document": {
                      "schema_version": 1,
                      "normalization_version": "ordered-article-v1",
                      "blocks": [
                        {
                          "block_id": "article:block:0001",
                          "source_order": 1,
                          "type": "heading",
                          "level": 2,
                          "text": "REMOVAL"
                        },
                        {
                          "block_id": "article:block:0002",
                          "source_order": 2,
                          "type": "step",
                          "number": 1,
                          "text": "Disconnect the battery negative cable."
                        },
                        {
                          "block_id": "article:block:0003",
                          "source_order": 3,
                          "type": "image",
                          "image_id": "image-1",
                          "asset_id": "image-1",
                          "alt": "Oil pump location"
                        }
                      ]
                    },
                    "images": [
                      {
                        "id": "image-1",
                        "url": "/v1/catalog/images/IiIiIiIiIiIiIiIiHwuS-wx8k9Ql3htAjUd6PVg2n76mnd0I-cZlfDg9aebtUBIpKO8j5A"
                      }
                    ],
                    "provenance": [
                      {
                        "id": "source-snapshot-1",
                        "version": "autoapi-http-v1"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/vehicles/{vehicle_id}/articles/{article_id}/source": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "getStoredArticleSource",
        "summary": "Read the stored source copy for an article",
        "description": "Reads the immutable source snapshot already stored by AutoData. It does not call a source provider. JSON returns sanitized source content; browser navigation returns a CSP-protected HTML review page. Source images use already-localized same-origin opaque media tokens or are omitted.",
        "parameters": [
          {
            "$ref": "#/components/parameters/VehicleId"
          },
          {
            "$ref": "#/components/parameters/ArticleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Stored source copy in the representation selected by Accept.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceContentResponse"
                },
                "example": {
                  "version": "v1",
                  "source": {
                    "available": true,
                    "snapshot_id": "source-snapshot-1",
                    "version": "autoapitwo-content-v1",
                    "content_sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                    "format": "html",
                    "url": "/v1/catalog/vehicles/vehicle-1/articles/article-1/source"
                  },
                  "content": "<html><body><h2>REMOVAL</h2><p>Remove the cover.</p></body></html>"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "Sanitized CSP-protected HTML source review document."
                }
              }
            },
            "headers": {
              "Content-Security-Policy": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "example": "nosniff"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/images/{token}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "getOpaqueCatalogImage",
        "summary": "Fetch a source-backed image using its opaque media token",
        "description": "The randomized token is an AutoData-issued capability URL for an already-localized object-storage asset. It is not a provider URL or public storage key. No bearer token is required for this route; tokens fail closed when unavailable or invalid.",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "description": "Randomized authenticated opaque media token returned in an article or stored-source image URL.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "minLength": 1,
              "maxLength": 6000,
              "example": "IiIiIiIiIiIiIiIiHwuS-wx8k9Ql3htAjUd6PVg2n76mnd0I-cZlfDg9aebtUBIpKO8j5A"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Allowlisted image bytes.",
            "content": {
              "image/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Token is invalid, expired, or not allowlisted.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "catalog image not found"
                }
              }
            }
          },
          "502": {
            "description": "Upstream image could not be retrieved or did not return image bytes.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "catalog image could not be loaded"
                }
              }
            }
          },
          "503": {
            "description": "Stable media-reference key is not configured.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "catalog image references are unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/v1/catalog/images": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "rejectLegacyCatalogImageReference",
        "summary": "Reject the legacy source-bearing image route",
        "description": "This path rejects legacy requests. The old src query parameter is intentionally not accepted because it reveals a source provider and original artifact path. Use the opaque token path instead.",
        "deprecated": true,
        "security": [],
        "responses": {
          "400": {
            "description": "An opaque image token path is required; this endpoint never fetches a caller-supplied URL.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "opaque image reference required"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "AutoDataToken",
        "description": "Example local token is `local:demo:dataset_viewer`."
      }
    },
    "parameters": {
      "Year": {
        "name": "year",
        "in": "path",
        "required": true,
        "description": "Model year.",
        "schema": {
          "type": "integer",
          "minimum": 1886,
          "maximum": 2100,
          "example": 1997
        }
      },
      "Make": {
        "name": "make",
        "in": "path",
        "required": true,
        "description": "Make slug returned by the makes endpoint.",
        "schema": {
          "type": "string",
          "example": "toyota"
        }
      },
      "Model": {
        "name": "model",
        "in": "path",
        "required": true,
        "description": "Model slug returned by the models endpoint.",
        "schema": {
          "type": "string",
          "example": "rav4"
        }
      },
      "Region": {
        "name": "region",
        "in": "query",
        "required": false,
        "description": "Market/region filter.",
        "schema": {
          "type": "string",
          "default": "US",
          "example": "US"
        }
      },
      "VehicleId": {
        "name": "vehicle_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid",
          "example": "0148245f-ec44-5172-bafe-0ad19e616098"
        }
      },
      "ArticleId": {
        "name": "article_id",
        "in": "path",
        "required": true,
        "description": "Catalog article UUID or provider article ID returned by the catalog.",
        "schema": {
          "type": "string",
          "example": "50064179-6be5-5fa7-8678-335cb42c523c"
        }
      }
    },
    "schemas": {
      "YearsResponse": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Year"
            }
          }
        }
      },
      "Year": {
        "type": "object",
        "required": [
          "year"
        ],
        "properties": {
          "year": {
            "type": "integer",
            "example": 2024
          }
        }
      },
      "MakesResponse": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NamedOption"
            }
          },
          "complete": {
            "type": "boolean",
            "description": "True when the returned make list is complete in the normalized catalog."
          },
          "hydrating": {
            "type": "boolean",
            "description": "True while missing source data is being hydrated in the background; repeat the read to obtain the complete list."
          }
        }
      },
      "ModelsResponse": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NamedOption"
            }
          },
          "complete": {
            "type": "boolean",
            "description": "True when the returned model list is complete in the normalized catalog."
          },
          "hydrating": {
            "type": "boolean",
            "description": "True while missing source data is being hydrated in the background; repeat the read to obtain the complete list."
          }
        }
      },
      "NamedOption": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "toyota"
          },
          "name": {
            "type": "string",
            "example": "Toyota"
          }
        }
      },
      "ConfigurationsResponse": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Configuration"
            }
          },
          "complete": {
            "type": "boolean",
            "description": "True when the returned configuration list is complete in the normalized catalog."
          },
          "hydrating": {
            "type": "boolean",
            "description": "True while missing source data is being hydrated in the background; repeat the read to obtain the complete list."
          }
        }
      },
      "Configuration": {
        "type": "object",
        "required": [
          "id",
          "vehicle_id",
          "year",
          "make",
          "model",
          "complete"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "year": {
            "type": "integer"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "trim": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "complete": {
            "type": "boolean"
          }
        }
      },
      "ArticlesResponse": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "complete": {
            "type": "boolean",
            "description": "Whether the saved article index is available."
          },
          "hydrating": {
            "type": "boolean",
            "description": "Whether a missing article index is being filled from configured sources."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArticleSummary"
            }
          }
        }
      },
      "ArticleSummary": {
        "type": "object",
        "required": [
          "id",
          "vehicle_id",
          "title",
          "content_status",
          "complete"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "example": "procedure"
          },
          "component": {
            "type": "string",
            "example": "oil_pump"
          },
          "content_status": {
            "type": "string",
            "enum": [
              "list_only",
              "content_complete"
            ]
          },
          "complete": {
            "type": "boolean"
          }
        }
      },
      "ArticleResponse": {
        "type": "object",
        "required": [
          "version",
          "article"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "article": {
            "$ref": "#/components/schemas/Article"
          }
        }
      },
      "Article": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArticleSummary"
          },
          {
            "type": "object",
            "properties": {
              "body": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Step"
                }
              },
              "document": {
                "$ref": "#/components/schemas/ArticleDocument"
              },
              "images": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Image"
                }
              },
              "provenance": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Provenance"
                }
              },
              "source_review": {
                "$ref": "#/components/schemas/SourceReview"
              }
            }
          }
        ]
      },
      "Step": {
        "type": "object",
        "required": [
          "number",
          "instructions"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "heading": {
            "type": "string"
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ArticleDocument": {
        "type": "object",
        "required": [
          "schema_version",
          "normalization_version",
          "blocks"
        ],
        "description": "Ordered normalized source blocks. Array order is authoritative and is preserved for display.",
        "properties": {
          "schema_version": {
            "type": "integer",
            "example": 1
          },
          "normalization_version": {
            "type": "string",
            "example": "ordered-article-v1"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArticleDocumentBlock"
            }
          }
        }
      },
      "ArticleDocumentBlock": {
        "type": "object",
        "required": [
          "type"
        ],
        "description": "One source-order-preserving content block. Fields are populated according to type.",
        "properties": {
          "block_id": {
            "type": "string"
          },
          "source_order": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "heading",
              "paragraph",
              "step",
              "table",
              "callout",
              "image",
              "ordered_list",
              "unordered_list",
              "link",
              "break",
              "unknown"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "format": "uri-reference"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {}
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asset_id": {
            "type": "string"
          },
          "image_id": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "unavailable_reason": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_locator": {
            "type": "string"
          }
        }
      },
      "Image": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "image_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri-reference"
          },
          "alt": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          }
        },
        "description": "Public image reference. Internal object-storage keys and upstream source URLs are never returned."
      },
      "Provenance": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "CATALOG_NOT_FOUND"
              },
              "message": {
                "type": "string",
                "example": "catalog resource not found"
              },
              "retryable": {
                "type": "boolean",
                "example": false
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "SourceReview": {
        "type": "object",
        "required": [
          "available"
        ],
        "properties": {
          "available": {
            "type": "boolean"
          },
          "snapshot_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "format": {
            "type": "string",
            "enum": [
              "html",
              "json"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri-reference",
            "description": "Same-origin URL for the stored source copy."
          }
        }
      },
      "SourceContentResponse": {
        "type": "object",
        "required": [
          "version",
          "source",
          "content"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "source": {
            "$ref": "#/components/schemas/SourceReview"
          },
          "content": {
            "type": "string",
            "description": "Sanitized stored source content; HTML when source.format is html, otherwise pretty-printed JSON."
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Dataset viewer role required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InvalidRequest": {
        "description": "Invalid path or query parameter",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Catalog resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "CatalogUnavailable": {
        "description": "Catalog database or source hydration unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
