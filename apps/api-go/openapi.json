{
  "openapi": "3.0.3",
  "info": {
    "title": "AutoData Provider-Neutral Catalog API",
    "version": "1.0.0",
    "description": "Read-only catalog API for external applications. AutoData resolves the vehicle cascade from its normalized database and hydrates missing scopes from configured sources. Article responses contain ordered normalized documents; immutable source originals remain internal.",
    "contact": {
      "name": "AutoData"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin AutoData API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Catalog",
      "description": "Vehicle selection and normalized article reads"
    }
  ],
  "paths": {
    "/v1/catalog/years": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listCatalogYears",
        "summary": "List available model years",
        "description": "Returns the normalized year manifest. A missing manifest triggers source hydration.",
        "responses": {
          "200": {
            "description": "Available years",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YearsResponse"
                },
                "example": {
                  "version": "v1",
                  "items": [
                    {
                      "year": 2024
                    },
                    {
                      "year": 2025
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/years/{year}/makes": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listCatalogMakes",
        "summary": "List makes for a model year",
        "parameters": [
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Region"
          }
        ],
        "responses": {
          "200": {
            "description": "Available makes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MakesResponse"
                },
                "example": {
                  "version": "v1",
                  "items": [
                    {
                      "id": "toyota",
                      "name": "Toyota"
                    },
                    {
                      "id": "honda",
                      "name": "Honda"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/years/{year}/makes/{make}/models": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listCatalogModels",
        "summary": "List models for a year and make",
        "parameters": [
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Make"
          },
          {
            "$ref": "#/components/parameters/Region"
          }
        ],
        "responses": {
          "200": {
            "description": "Available models",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                },
                "example": {
                  "version": "v1",
                  "items": [
                    {
                      "id": "rav4",
                      "name": "Rav4"
                    },
                    {
                      "id": "camry",
                      "name": "Camry"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/years/{year}/makes/{make}/models/{model}/configurations": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listCatalogConfigurations",
        "summary": "List engine, base, and trim configurations",
        "parameters": [
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Make"
          },
          {
            "$ref": "#/components/parameters/Model"
          },
          {
            "$ref": "#/components/parameters/Region"
          }
        ],
        "responses": {
          "200": {
            "description": "Available vehicle configurations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigurationsResponse"
                },
                "example": {
                  "version": "v1",
                  "items": [
                    {
                      "id": "065e138d-72ea-5110-b05e-d89f5445a251",
                      "vehicle_id": "0148245f-ec44-5172-bafe-0ad19e616098",
                      "year": 1997,
                      "make": "Toyota",
                      "model": "Rav4",
                      "region": "US",
                      "trim": "Base",
                      "engine": 2.0,
                      "complete": true
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/vehicles/{vehicle_id}/articles": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listVehicleArticles",
        "summary": "List the vehicle's available articles",
        "description": "Returns the article catalog. Article bodies are hydrated only when the selected article detail is requested.",
        "parameters": [
          {
            "$ref": "#/components/parameters/VehicleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle article catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticlesResponse"
                },
                "example": {
                  "version": "v1",
                  "items": [
                    {
                      "id": "50064179-6be5-5fa7-8678-335cb42c523c",
                      "vehicle_id": "0148245f-ec44-5172-bafe-0ad19e616098",
                      "title": "Oil Pump Removal and Installation",
                      "kind": "procedure",
                      "component": "oil_pump",
                      "content_status": "content_complete",
                      "complete": true
                    },
                    {
                      "id": "0762fef0-536b-5cae-bd2a-bf9972082048",
                      "vehicle_id": "0148245f-ec44-5172-bafe-0ad19e616098",
                      "title": "Timing Belt Removal and Installation",
                      "kind": "procedure",
                      "component": "timing_belt",
                      "content_status": "content_complete",
                      "complete": true
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    },
    "/v1/catalog/vehicles/{vehicle_id}/articles/{article_id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "getNormalizedArticle",
        "summary": "Get one normalized article",
        "description": "Returns normalized content with fixed source order, local image references, and source provenance identifiers. Selecting a list-only article triggers one targeted source ingestion before the response.",
        "parameters": [
          {
            "$ref": "#/components/parameters/VehicleId"
          },
          {
            "$ref": "#/components/parameters/ArticleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Normalized article",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleResponse"
                },
                "example": {
                  "version": "v1",
                  "article": {
                    "id": "50064179-6be5-5fa7-8678-335cb42c523c",
                    "vehicle_id": "0148245f-ec44-5172-bafe-0ad19e616098",
                    "title": "Oil Pump Removal and Installation",
                    "kind": "procedure",
                    "component": "oil_pump",
                    "content_status": "content_complete",
                    "complete": true,
                    "body": "Remove the oil pan before removing the oil pump.",
                    "steps": [
                      {
                        "number": 1,
                        "heading": "Removal",
                        "instructions": [
                          "Disconnect the battery negative cable."
                        ],
                        "image_ids": []
                      },
                      {
                        "number": 2,
                        "heading": "Removal",
                        "instructions": [
                          "Remove the oil pan and detach the oil pump."
                        ]
                      }
                    ],
                    "document": {
                      "schema_version": 1,
                      "normalization_version": "ordered-article-v1",
                      "blocks": [
                        {
                          "block_id": "article:block:0001",
                          "source_order": 1,
                          "type": "heading",
                          "level": 2,
                          "text": "REMOVAL"
                        },
                        {
                          "block_id": "article:block:0002",
                          "source_order": 2,
                          "type": "step",
                          "number": 1,
                          "text": "Disconnect the battery negative cable."
                        },
                        {
                          "block_id": "article:block:0003",
                          "source_order": 3,
                          "type": "image",
                          "image_id": "image-1",
                          "asset_id": "image-1",
                          "alt": "Oil pump location"
                        }
                      ]
                    },
                    "images": [
                      {
                        "id": "image-1",
                        "url": "/v1/catalog/images/image-1"
                      }
                    ],
                    "provenance": [
                      {
                        "id": "source-snapshot-1",
                        "version": "autoapi-http-v1"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/CatalogUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "AutoDataToken",
        "description": "Example local token is `local:demo:dataset_viewer`."
      }
    },
    "parameters": {
      "Year": {
        "name": "year",
        "in": "path",
        "required": true,
        "description": "Model year.",
        "schema": {
          "type": "integer",
          "minimum": 1886,
          "maximum": 2100,
          "example": 1997
        }
      },
      "Make": {
        "name": "make",
        "in": "path",
        "required": true,
        "description": "Make slug returned by the makes endpoint.",
        "schema": {
          "type": "string",
          "example": "toyota"
        }
      },
      "Model": {
        "name": "model",
        "in": "path",
        "required": true,
        "description": "Model slug returned by the models endpoint.",
        "schema": {
          "type": "string",
          "example": "rav4"
        }
      },
      "Region": {
        "name": "region",
        "in": "query",
        "required": false,
        "description": "Market/region filter.",
        "schema": {
          "type": "string",
          "default": "US",
          "example": "US"
        }
      },
      "VehicleId": {
        "name": "vehicle_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid",
          "example": "0148245f-ec44-5172-bafe-0ad19e616098"
        }
      },
      "ArticleId": {
        "name": "article_id",
        "in": "path",
        "required": true,
        "description": "Catalog article UUID or provider article ID returned by the catalog.",
        "schema": {
          "type": "string",
          "example": "50064179-6be5-5fa7-8678-335cb42c523c"
        }
      }
    },
    "schemas": {
      "YearsResponse": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Year"
            }
          }
        }
      },
      "Year": {
        "type": "object",
        "required": [
          "year"
        ],
        "properties": {
          "year": {
            "type": "integer",
            "example": 2024
          }
        }
      },
      "MakesResponse": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NamedOption"
            }
          },
          "complete": {
            "type": "boolean",
            "description": "True when the returned make list is complete in the normalized catalog."
          },
          "hydrating": {
            "type": "boolean",
            "description": "True while missing source data is being hydrated in the background; repeat the read to obtain the complete list."
          }
        }
      },
      "ModelsResponse": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NamedOption"
            }
          },
          "complete": {
            "type": "boolean",
            "description": "True when the returned model list is complete in the normalized catalog."
          },
          "hydrating": {
            "type": "boolean",
            "description": "True while missing source data is being hydrated in the background; repeat the read to obtain the complete list."
          }
        }
      },
      "NamedOption": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "toyota"
          },
          "name": {
            "type": "string",
            "example": "Toyota"
          }
        }
      },
      "ConfigurationsResponse": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Configuration"
            }
          },
          "complete": {
            "type": "boolean",
            "description": "True when the returned configuration list is complete in the normalized catalog."
          },
          "hydrating": {
            "type": "boolean",
            "description": "True while missing source data is being hydrated in the background; repeat the read to obtain the complete list."
          }
        }
      },
      "Configuration": {
        "type": "object",
        "required": [
          "id",
          "vehicle_id",
          "year",
          "make",
          "model",
          "complete"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "year": {
            "type": "integer"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "trim": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "complete": {
            "type": "boolean"
          }
        }
      },
      "ArticlesResponse": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "complete": {
            "type": "boolean",
            "description": "Whether the saved article index is available."
          },
          "hydrating": {
            "type": "boolean",
            "description": "Whether a missing article index is being filled from configured sources."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArticleSummary"
            }
          }
        }
      },
      "ArticleSummary": {
        "type": "object",
        "required": [
          "id",
          "vehicle_id",
          "title",
          "content_status",
          "complete"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "example": "procedure"
          },
          "component": {
            "type": "string",
            "example": "oil_pump"
          },
          "content_status": {
            "type": "string",
            "enum": [
              "list_only",
              "content_complete"
            ]
          },
          "complete": {
            "type": "boolean"
          }
        }
      },
      "ArticleResponse": {
        "type": "object",
        "required": [
          "version",
          "article"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "v1"
          },
          "article": {
            "$ref": "#/components/schemas/Article"
          }
        }
      },
      "Article": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArticleSummary"
          },
          {
            "type": "object",
            "properties": {
              "body": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Step"
                }
              },
              "document": {
                "$ref": "#/components/schemas/ArticleDocument"
              },
              "images": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Image"
                }
              },
              "provenance": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Provenance"
                }
              }
            }
          }
        ]
      },
      "Step": {
        "type": "object",
        "required": [
          "number",
          "instructions"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "heading": {
            "type": "string"
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ArticleDocument": {
        "type": "object",
        "required": [
          "schema_version",
          "normalization_version",
          "blocks"
        ],
        "description": "Ordered normalized source blocks. Array order is authoritative and is preserved for display.",
        "properties": {
          "schema_version": {
            "type": "integer",
            "example": 1
          },
          "normalization_version": {
            "type": "string",
            "example": "ordered-article-v1"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArticleDocumentBlock"
            }
          }
        }
      },
      "ArticleDocumentBlock": {
        "type": "object",
        "required": [
          "type"
        ],
        "description": "One source-order-preserving content block. Fields are populated according to type.",
        "properties": {
          "block_id": {
            "type": "string"
          },
          "source_order": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "heading",
              "paragraph",
              "step",
              "table",
              "callout",
              "image",
              "ordered_list",
              "unordered_list",
              "link",
              "break",
              "unknown"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "format": "uri-reference"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {}
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asset_id": {
            "type": "string"
          },
          "image_id": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "unavailable_reason": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_locator": {
            "type": "string"
          }
        }
      },
      "Image": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "image_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri-reference"
          },
          "alt": {
            "type": "string"
          },
          "storage_key": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          }
        }
      },
      "Provenance": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "CATALOG_NOT_FOUND"
              },
              "message": {
                "type": "string",
                "example": "catalog resource not found"
              },
              "retryable": {
                "type": "boolean",
                "example": false
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Dataset viewer role required",
        "content": {
          "application/json": {
            "schema": {
