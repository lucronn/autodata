# AutoData Local Workspace Environment Configuration Template
# Copy or reference these variables in local configuration files (e.g. compose/.env or config/api.env).

# API & Gateway Settings (supported via --base-url, --api-url, --url, and --live-url in developer scripts)
AUTODATA_API_ADDR=:18080
AUTODATA_API_BASE_URL=http://127.0.0.1:18080
AUTODATA_API_URL=http://127.0.0.1:18080
AUTODATA_KNOWLEDGE_SMOKE_URL=
AUTODATA_PROJECTION_STORE=postgres
AUTODATA_READINESS_MODE=static
AUTODATA_IMAGE_URL_KEY=

# PostgreSQL Database (supported via --address and --database-url in developer scripts)
AUTODATA_DB_ADDRESS=127.0.0.1:5432
AUTODATA_POSTGRES_DB=autodata
AUTODATA_POSTGRES_USER=autodata

# S3 / MinIO Object Storage
AUTODATA_S3_ADDRESS=127.0.0.1:9000
AUTODATA_S3_ENDPOINT=127.0.0.1:9000
AUTODATA_SOURCE_BUCKET=autodata-sources

# NATS JetStream Messaging & Outbox Relay
AUTODATA_NATS_URL=nats://127.0.0.1:4222
AUTODATA_OUTBOX_BATCH_SIZE=50
AUTODATA_OUTBOX_MAX_ATTEMPTS=3
AUTODATA_OUTBOX_POLL_SECONDS=5
AUTODATA_OUTBOX_ONCE=0

# Payment Reconciliation Worker
AUTODATA_PAYMENT_RECONCILE_BATCH_SIZE=50
AUTODATA_PAYMENT_RECONCILE_POLL_SECONDS=15
AUTODATA_PAYMENT_RECONCILE_ONCE=0

# Ingestion Worker & HTTP Service
AUTODATA_INGESTION_HTTP_ADDR=:8081
AUTODATA_INGESTION_URL=http://127.0.0.1:8081
AUTODATA_SOURCE_PERSIST=1
AUTODATA_SOURCE_REGION=US

# Independent Source Connector v1 service origins. Override either provider on its own.
BANKONE_BASE_URL=https://bankone.cars.tk
BANKTWO_BASE_URL=https://banktwo.cars.tk

# Optional managed API key variables for independent bank sources (empty by default).
# Provide actual keys via local uncommitted configuration or a key manager.
AUTODATA_BANKONE_API_KEY=
AUTODATA_BANKTWO_API_KEY=
